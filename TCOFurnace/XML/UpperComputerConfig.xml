<?xml version="1.0" encoding="utf-8"?>
<!-- 
  上位机控制板卡配置文件 与 上位机仪器与
  功能：记录所有串口及连接的控制板硬件资源配置，用于上位机自动生成通信逻辑
  结构说明：
  - 根节点：ControlSystemConfig（整个控制系统配置）
  - 一级节点：SerialPorts（所有串口配置集合）
    - 每个SerialPort节点包含：串口参数 + 该串口连接的控制板列表
    - 每个ControlBoard节点包含：板卡基本信息 + 各类I/O资源配置
-->
<UpperComputerConfig>
	<!-- 串口列表 -->
	<SerialPorts>
		<!-- 第一路串口 -->
		<SerialPort id="COM3">
			<BaudRate>9600</BaudRate>
			<Parity>None</Parity>
			<DataBits>8</DataBits>
			<StopBits>1</StopBits>
			<!-- 该串口上的控制板列表 -->
			<ControlBoards>
				<!-- 第一块控制板 -->
				<ControlBoard deviceAddress="10" name="DAM1616D_MT1" offsetAddress="0">
					<Coils totalCount="16">
						<!-- id 回路编号, mapping实际映射的编号,name 控制的具体哪个模块  -->
						<Channel id="1" mapping="1" name="1路常开" unit="" dataFormat="1" />
						<Channel id="2" mapping="2" name="1路常闭" unit="" dataFormat="1" />
						<Channel id="3" mapping="3" name="2路常开" unit="" dataFormat="1" />
						<Channel id="4" mapping="4" name="2路常闭" unit="" dataFormat="1" />
						<Channel id="5" mapping="5" name="" unit="" dataFormat="1" />
						<Channel id="6" mapping="6" name="" unit="" dataFormat="1" />
						<Channel id="7" mapping="7" name="" unit="" dataFormat="1" />
						<Channel id="8" mapping="8" name="" unit="" dataFormat="1" />
						<Channel id="9" mapping="9" name="" unit="" dataFormat="1" />
						<Channel id="10" mapping="10" name="" unit="" dataFormat="1" />
						<Channel id="11" mapping="11" name="" unit="" dataFormat="1" />
						<Channel id="12" mapping="12" name="" unit="" dataFormat="1" />
						<Channel id="13" mapping="13" name="" unit="" dataFormat="1" />
						<Channel id="14" mapping="14" name="" unit="" dataFormat="1" />
						<Channel id="15" mapping="15" name="" unit="" dataFormat="1" />
						<Channel id="16" mapping="16" name="" unit="" dataFormat="1" />
					</Coils>
					<DiscreteInputs totalCount="16" >
						<!-- id 回路编号, mapping实际映射的编号,name 控制的具体哪个模块  -->
						<Channel id="1" mapping="1" name="" unit="" dataFormat="1" />
						<Channel id="2" mapping="2" name="" unit="" dataFormat="1" />
						<Channel id="3" mapping="3" name="" unit="" dataFormat="1" />
						<Channel id="4" mapping="4" name="" unit="" dataFormat="1" />
						<Channel id="5" mapping="5" name="" unit="" dataFormat="1" />
						<Channel id="6" mapping="6" name="" unit="" dataFormat="1" />
						<Channel id="7" mapping="7" name="" unit="" dataFormat="1" />
						<Channel id="8" mapping="8" name="" unit="" dataFormat="1" />
						<Channel id="9" mapping="9" name="" unit="" dataFormat="1" />
						<Channel id="10" mapping="10" name="" unit="" dataFormat="1" />
						<Channel id="11" mapping="11" name="" unit="" dataFormat="1" />
						<Channel id="12" mapping="12" name="" unit="" dataFormat="1" />
						<Channel id="13" mapping="13" name="" unit="" dataFormat="1" />
						<Channel id="14" mapping="14" name="" unit="" dataFormat="1" />
						<Channel id="15" mapping="15" name="" unit="" dataFormat="1" />
						<Channel id="16" mapping="16" name="" unit="" dataFormat="1" />
					</DiscreteInputs>
					<!-- 保持寄存器（改为Channel节点，子项作为属性） -->
					<HoldingRegisters totalCount="0"></HoldingRegisters>
					<!-- 输入寄存器（改为Channel节点，子项作为属性） -->
					<InputRegisters totalCount="0"></InputRegisters>
				</ControlBoard>

				<!-- 第二块控制板 -->
				<ControlBoard deviceAddress="254" name="JY_DAMAIAO1" offsetAddress="0">
					<Coils totalCount="0" ></Coils>
					<DiscreteInputs totalCount="0"></DiscreteInputs>
					<HoldingRegisters totalCount="6">
						<Channel id="1" mapping="1" name="1氧调压" unit="μA" dataFormat="1000" />
						<Channel id="2" mapping="2" name="1催调压" unit="μA" dataFormat="1000" />
						<Channel id="3" mapping="3" name="2氧调压" unit="μA" dataFormat="1000" />
						<Channel id="4" mapping="4" name="2催调压" unit="μA" dataFormat="1000" />
						<Channel id="5" mapping="5" name="2流量计4-20mA流量设定" unit="" dataFormat="1" />
						<Channel id="6" mapping="6" name="1流量计4-20mA流量设定" unit="" dataFormat="1" />
					</HoldingRegisters>

					<InputRegisters totalCount="6">
						<Channel id="1" mapping="1" name="1流量计流量读" unit="" dataFormat="1" />
						<Channel id="2" mapping="2" name="2流量计流量读" unit="" dataFormat="1" />
						<Channel id="3" mapping="3" name="" unit="" dataFormat="1" />
						<Channel id="4" mapping="4" name="" unit="" dataFormat="1" />
						<Channel id="5" mapping="5" name="" unit="" dataFormat="1" />
						<Channel id="6" mapping="6" name="" unit="" dataFormat="1" />
					</InputRegisters>

				</ControlBoard>
			</ControlBoards>
		</SerialPort>

		<!-- 第二路串口 - ->
		<SerialPort id="COM2">
      <BaudRate>9600</BaudRate>
      <Parity>None</Parity>
      <DataBits>8</DataBits>
      <StopBits>1</StopBits>
      
      <ControlBoards>
        <!- - 温度控制板A：负责加热系统的温度调节 - ->
		<ControlBoard deviceAddress="1" name="温度控制板A">
			<Coils totalCount="16" />
			<DiscreteInputs totalCount="8" />

			<HoldingRegisters totalCount="32">
				<Register id="0">
					<Name>目标温度设置</Name>
					<Unit>℃</Unit>
					<DataFormat>Decimal</DataFormat>
				</Register>
				<!- - 其他保持寄存器配置省略 - ->
			</HoldingRegisters>

			<InputRegisters totalCount="16">
				<Register id="0">
					<Name>当前温度</Name>
					<Unit>℃</Unit>
					<DataFormat>Decimal</DataFormat>
				</Register>
				<!- - 其他输入寄存器配置省略 - ->
			</InputRegisters>
		</ControlBoard>

		<!- - 电机控制板A：负责传送带电机的转速控制 - ->
		<ControlBoard deviceAddress="2" name="电机控制板A">
			<!- - 配置内容省略 - ->
		</ControlBoard>
		</ControlBoards>
		</SerialPort>-->
	</SerialPorts>

	<!-- 仪器列表及端口映射 -->
	<Instruments>
		<Instrument InstrumentId="INST01" Name="氚碳氧化炉1号反应管">
			<!-- 该仪器使用的端口 -->
			<AssociatedPorts>
				<PortReference Id="Coils1" PortId="COM3" BoardId="DAM1616D_MT1"  RegisterType="Coils" ChannelId="1" Description="1路常开"/>
				<PortReference Id="Coils2" PortId="COM3" BoardId="DAM1616D_MT1"  RegisterType="Coils" ChannelId="2" Description="1路常闭"/>
				<PortReference Id="HoldingRegisters1" PortId="COM3" BoardId="JY_DAMAIAO1"  RegisterType="HoldingRegisters" ChannelId="1" Description="1氧调压"/>
				<PortReference Id="HoldingRegisters2" PortId="COM3" BoardId="JY_DAMAIAO1"  RegisterType="HoldingRegisters" ChannelId="2" Description="1催调压"/>
				<PortReference Id="InputRegisters1" PortId="COM3" BoardId="JY_DAMAIAO1"  RegisterType="InputRegisters" ChannelId="1" Description="1流量计4-20mA流量设定"/>
			</AssociatedPorts>
			<!-- 仪器特定参数 -->
			<Settings>
				<Setting Name="MeasurementInterval" Value="1000" />
				<Setting Name="DataFormat" Value="ASCII" />
			</Settings>
		</Instrument>

		<Instrument InstrumentId="INST02" Name="氚碳氧化炉2号反应管">
			<!-- 该仪器使用的端口 -->
			<AssociatedPorts>
				<PortReference Id="Coils1" PortId="COM3" BoardId="DAM1616D_MT1"  RegisterType="Coils" ChannelId="3" Description="2路常开"/>
				<PortReference Id="Coils2" PortId="COM3" BoardId="DAM1616D_MT1"  RegisterType="Coils" ChannelId="4" Description="2路常开"/>
				<PortReference Id="HoldingRegisters1" PortId="COM3" BoardId="JY_DAMAIAO1"  RegisterType="HoldingRegisters" ChannelId="3" Description="2路常开"/>
				<PortReference Id="HoldingRegisters2" PortId="COM3" BoardId="JY_DAMAIAO1"  RegisterType="HoldingRegisters" ChannelId="4" Description="2路常开"/>
				<PortReference Id="InputRegisters1" PortId="COM3" BoardId="JY_DAMAIAO1"  RegisterType="InputRegisters" ChannelId="2" Description="2流量计4-20mA流量设定"/>
			</AssociatedPorts>
			<!-- 仪器特定参数 -->
			<Settings>
				<Setting Name="MaxSpeed" Value="15000" />
				<Setting Name="SafetyLevel" Value="High" />
			</Settings>
		</Instrument>
	</Instruments>
</UpperComputerConfig>
